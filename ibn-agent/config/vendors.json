  "juniper": {
    "device_type": "juniper_junos",
    "prompt_hint": "switch Juniper JunOS (EX/QFX Series)",
    "save_config": "commit",
    "port_format": "ge-0/0/{n}",
    "commands": {
      "show_version": "show version",
      "show_interfaces": "show interfaces terse",
      "show_vlans": "show vlans",
      "show_stp": "show spanning-tree bridge",
      "show_mac": "show ethernet-switching table",
      "show_routing": "show route",
      "shutdown_port": [
        "set interfaces {iface} disable",
        "set interfaces {iface} description IBN-DISABLED: {reason}"
      ],
      "enable_port": [
        "delete interfaces {iface} disable",
        "delete interfaces {iface} description"
      ],
      "set_vlan": [
        "set interfaces {iface} unit 0 family ethernet-switching vlan members {vlan}"
      ],
      "create_vlan": [
        "set vlans {name} vlan-id {vlan}"
      ],
      "delete_vlan": [
        "delete vlans {name}"
      ],
      "set_trunk": [
        "set interfaces {iface} unit 0 family ethernet-switching interface-mode trunk"
      ],
      "stp_priority": [
        "set protocols rstp bridge-priority {priority}"
      ],
      "bpdu_guard": [
        "set protocols rstp interface {iface} edge"
      ],
      "port_mirror": [
        "set forwarding-options analyzer {sid} input ingress interface {src}",
        "set forwarding-options analyzer {sid} output interface {dst}"
      ],
      "lacp": [
        "set interfaces ae{pc_id} aggregated-ether-options lacp {mode}",
        "set interfaces {iface} ether-options 802.3ad ae{pc_id}"
      ],
      "acl_create": [
        "set firewall family inet filter {name}"
      ],
      "acl_apply": [
        "set interfaces {iface} unit 0 family inet filter {direction} {name}"
      ],
      "save": "commit"
    }
  },
