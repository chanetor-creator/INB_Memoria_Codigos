  "mikrotik": {
    "device_type": "mikrotik_routeros",
    "prompt_hint": "switch MikroTik RouterOS (CRS Series muy popular en LATAM)",
    "save_config": "export file=backup",
    "port_format": "ether{n}",
    "commands": {
      "show_version": "/system resource print",
      "show_interfaces": "/interface print",
      "show_vlans": "/interface vlan print",
      "show_mac": "/ip arp print",
      "show_routing": "/ip route print",
      "shutdown_port": [
        "/interface set {iface} disabled=yes comment=IBN-DISABLED:{reason}"
      ],
      "enable_port": [
        "/interface set {iface} disabled=no comment=\"\""
      ],
      "set_vlan": [
        "/interface vlan add name=vlan{vlan} vlan-id={vlan} interface={iface}"
      ],
      "create_vlan": [
        "/interface vlan add name={name} vlan-id={vlan}"
      ],
      "delete_vlan": [
        "/interface vlan remove [find vlan-id={vlan}]"
      ],
      "stp_priority": [
        "/interface bridge set bridge priority={priority}"
      ],
      "bpdu_guard": [
        "/interface bridge port set [find interface={iface}] bpdu-guard=yes"
      ],
      "port_mirror": [
        "/tool sniffer set interface={src} filter-interface={dst}",
        "/tool sniffer start"
      ],
      "save": "export file=backup"
    }
  },
